<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>instagram</title>
</head>
<body>
    <h1 style="text-align: center;">instagram page</h1>
    <h2>name : <%= user %></h2>
    <div style="display: flex;">
        <div>
            <h3><%= Math.floor(Math.random() * 10000 )+ 1 %></h3>
            <h3>following</h3>
        </div>
         <div>
            <h3><%= Math.floor(Math.random() * 10000 )+ 1 %></h3>
            <h3>followers</h3>
        </div>
    </div>
    <h3>Accounts that follow you : </h3>
    <ul>
        <% for( name of names ) { %>
        <li><%= name %></li>
        <% } %>
    </ul>
</body>
</html>